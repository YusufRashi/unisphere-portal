# Copy to .env and replace every placeholder. Never commit .env.
# The backend also reads this file when started from ./backend (spring.config.import), so the same
# values work for `docker compose up` and for running the API from your IDE.

# --- PostgreSQL --------------------------------------------------------------
# Superuser password for the database container (used only by the init script).
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-value
# Least-privileged role the application connects as (created by docker/postgres/init).
DB_USERNAME=unisphere_app
DB_PASSWORD=replace-with-another-long-random-value
# Used when running the API outside Docker against the compose database.
DB_URL=jdbc:postgresql://localhost:5432/unisphere

# --- Security ----------------------------------------------------------------
# Base64 secret of at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=
# true in production (HTTPS). false is only acceptable for plain-http local development.
COOKIE_SECURE=false
# Only needed if the SPA is served from a different origin than the API (comma separated).
CORS_ALLOWED_ORIGINS=

# --- Application -------------------------------------------------------------
# Public URL of the web app; used to build activation and password-reset links.
APP_BASE_URL=http://localhost:3000
# Name printed on transcripts (not a secret).
UNIVERSITY_NAME=UniSphere University
# ISO 4217 currency for fee accounts (not a secret).
FEE_CURRENCY=KES
# When deadline and fee reminders are sent (Spring cron, UTC). "-" turns them off.
NOTIFICATION_REMINDER_CRON=0 0 6 * * *
# Creates the first administrator on startup if none exists. Remove after first login.
# Password rules: 10+ characters, a letter and a digit, must not contain the email name.
BOOTSTRAP_ADMIN_EMAIL=registrar@unisphere.local
BOOTSTRAP_ADMIN_PASSWORD=
# Development only: print activation/reset links to the backend log instead of emailing them.
MAIL_LOG_LINKS=true
