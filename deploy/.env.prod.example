# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.prod and replace every placeholder.

# Public host name. Its DNS must point at this server so Caddy can obtain a TLS certificate.
DOMAIN=portal.example.edu

# Published images: <prefix>-api:<tag> and <prefix>-web:<tag> (see .github/workflows/release.yml).
IMAGE_PREFIX=ghcr.io/your-org/unisphere
IMAGE_TAG=latest

# Generate each with: openssl rand -base64 48
POSTGRES_SUPERUSER_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

DB_USERNAME=unisphere_app
# Uncomment for a managed database (and remove the db service from the Compose file).
# DB_URL=jdbc:postgresql://db.example.com:5432/unisphere

UNIVERSITY_NAME=UniSphere University
FEE_CURRENCY=KES

# Creates the first administrator if none exists. Remove both after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
